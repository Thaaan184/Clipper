# ClipForge v2 Environment Configuration
CF_DATA_DIR=./data
CF_DB_PATH=./data/clipforge.db
CF_BIND=127.0.0.1
CF_PORT=8000
CF_API_TOKEN=
CF_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
CF_ALLOWED_HOSTS=["youtube.com","www.youtube.com","m.youtube.com","youtu.be"]
CF_MAX_VOD_SECONDS=28800
CF_MAX_CONCURRENT_JOBS=1
CF_MAX_CONCURRENT_FFMPEG=2

# ASR & Audio
CF_WHISPER_MODEL=base
CF_WHISPER_DEVICE=auto
CF_WHISPER_COMPUTE=auto

# LLM Gateway (OpenAI-compatible)
CF_LLM_BASE_URL=http://localhost:20128/v1
CF_LLM_API_KEY=
CF_LLM_MODEL=gemini-2.5-flash
CF_LLM_VISION_MODEL=

# Video Encoding & Housekeeping
CF_FFMPEG_ENCODER=libx264
CF_TTL_HOURS=168
CF_COOKIES_FILE=
CF_PRESET_DIR=./presets
