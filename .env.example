# ── LLM API (9Router / OpenAI-compatible) ─────────────────────────────────────
LLM_API_BASE=http://your-9router-host:port/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=ag/gemini-3.8-flash-medium

# ── App Config ─────────────────────────────────────────────────────────────────
PORT=8080
DATA_DIR=./data
MAX_VIDEO_DURATION=10800        # seconds (3 hours)
MAX_CONCURRENT_RENDERS=3
MAX_PENDING_JOBS=5
MAX_DISK_GB=10

# ── Whisper Fallback ───────────────────────────────────────────────────────────
WHISPER_MODEL=large-v3          # base | small | medium | large-v3
WHISPER_DEVICE=cpu              # cpu | cuda

# ── CORS (comma-separated origins) ────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_SCANS_PER_HOUR=5
