FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    CF_DATA_DIR=/app/data \
    CF_DB_PATH=/app/data/clipforge.db \
    CF_BIND=0.0.0.0 \
    CF_PORT=8000

# Install runtime dependencies: FFmpeg with libass support and OFL fonts
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libass-dev \
    fonts-dejavu-core \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Create non-root user
RUN useradd -u 1000 -m appuser && \
    mkdir -p /app/data && \
    chown -R appuser:appuser /app

# Copy dependency specifications
COPY apps/api/pyproject.toml apps/api/README.md /app/apps/api/

# Install dependencies
RUN pip install --upgrade pip && \
    pip install "fastapi>=0.115.0" "uvicorn[standard]>=0.30.0" "pydantic>=2.8.0" "pydantic-settings>=2.5.0" \
                "aiosqlite>=0.20.0" "httpx>=0.27.0" "structlog>=24.1.0" "numpy>=1.26.0" "scipy>=1.12.0" \
                "yt-dlp>=2025.1.1" "faster-whisper>=1.0.3" "pillow>=10.2.0" "python-multipart>=0.0.9" \
                "aiofiles>=24.1.0" "openai>=1.51.0"

# Copy API application source
COPY apps/api/src/ /app/apps/api/src/
RUN pip install -e /app/apps/api --no-deps

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://127.0.0.1:8000/healthz || exit 1

CMD ["uvicorn", "clipforge.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
